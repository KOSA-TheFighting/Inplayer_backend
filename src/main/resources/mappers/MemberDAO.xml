    <!-- 회원 가입 처리 -->
    <insert id="saveMember" parameterType="com.webrtc.member.model.dto.MemberDTO">
        INSERT INTO member (member_id, member_name, member_nickname, member_email, member_created_date, member_delete_yn, member_last_login, member_last_logout)
        VALUES (#{member_id}, #{member_name}, #{member_nickname}, #{member_email}, #{member_created_date}, #{member_delete_yn}, #{member_last_login}, #{member_last_logout})
    </insert>

