<mapper namespace="com.webrtc.member.dao.MemberDAO">

    <!-- 이메일로 회원 조회 -->
    <select id="findByEmail" resultType="com.webrtc.member.model.dto.MemberDTO">
        SELECT * FROM member
        WHERE member_email = #{member_email}
    </select>

