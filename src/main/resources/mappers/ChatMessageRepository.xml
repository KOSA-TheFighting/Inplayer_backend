<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.webrtc.signaling.repository.ChatMessageRepository">
	<sql id="search">
	
	</sql>
	
	<insert id="saveMessage" useGeneratedKeys="true" keyProperty="chatmessage_id">
		insert into chatmessage (
			 member_id
			,chatroom_id
			,messagetype_num
			,chatmessage_content
			,chatmessage_sent_time
		) values 
		<foreach collection="list" item="message" separator=",">	
			(
                #{message.member_id},
                #{message.chatroom_id},
                #{message.messagetype_num},
                #{message.chatmessage_content},
				#{message.chatmessage_sent_time}
			)
		</foreach>
	</insert>
</mapper>