<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.webrtc.signaling.repository.StreamRepository">

	<insert id="registerStream" useGeneratedKeys="true" keyProperty="stream_id">
		insert into stream (
			 member_id
			,streamtag_num
			,stream_title
			,stream_start_time
			,stream_description
			,stream_status
		) values (
			 #{member_id}
			,#{streamtag_num}
			,#{stream_title}
			,#{stream_start_time}
			,#{stream_description}
			,#{stream_status}
		)
	</insert>
	
</mapper>